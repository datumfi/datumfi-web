# Belt-and-suspenders: never serve internal/non-web files even if one ever
# reaches the publish root. dist/ is already built clean by scripts/build-dist.mjs;
# this is defense-in-depth at the Cloudflare asset-manifest layer.
.claude/
.wrangler/
*.xlsx
package.json
package-lock.json
*.md
*.py
*.ps1
_probe_*
_eyeson/
masterlogo.html
claude-*.txt
api-response.json

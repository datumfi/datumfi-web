node_modules/
.DS_Store
.env
*.log

# Gate receipts. 16 gates dump UTF-8 output to a file because the Windows console mangles
# unicode (— ⓘ ▸ curly quotes). Nothing reads them back — they are write-only receipts, never
# golden files. They used to land on tracked scripts/*.out.txt, so ANY suite run dirtied the
# tree and a clean-tree baseline was impossible by construction (_gate_ticker_ui embedded
# TODAY's date and re-drifted daily). Redirected here 2026-07-27.
scripts/.gate-out/

# ── Security hardening 2026-06-24 ───────────────────────────────────────────────
# A runaway PostToolUse hook in .claude/settings.local.json had been auto-running
# `wrangler pages deploy .` — publishing the ENTIRE working folder (uncommitted +
# untracked files) to datumfi.com. It is REMOVED. Deploys are now MANUAL clean-export
# only (tracked web files; never `deploy .`). These patterns keep internal/dev/personal
# material out of git and out of any deploy export.
.wrangler/
.claude/settings.local.json
_eyeson/
_tmp_*/
*.xlsx
~$*.xlsx
*.py
*.ps1
hover_raw.txt
meth_raw.txt
claude-*.txt

# Generated clean publish root (scripts/build-dist.mjs) — never commit, never deploy ".".
/dist/

# Stage-2 ticker importer local cache (regenerable, no-key, large — never commit)
scripts/_ticker-src/
